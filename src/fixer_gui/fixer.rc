#include "resource.h"
#include <windows.h>

// Window / taskbar icon
IDI_APP_ICON    ICON    "..\\..\\sekrio_ico.ico"

// Background image embedded as raw bytes; decoded at runtime by WIC
IDB_BACKGROUND  RCDATA  "..\\..\\background.jpg"

// Version information block
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,6,0,0
PRODUCTVERSION  1,6,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sekiro Mod Community"
            VALUE "FileDescription",  "Mod Engine 1.6 Fixer"
            VALUE "FileVersion",      "1.6.0.0"
            VALUE "InternalName",     "ModEngineFixer"
            VALUE "LegalCopyright",   "See LICENSE"
            VALUE "OriginalFilename", "ModEngineFixer.exe"
            VALUE "ProductName",      "Mod Engine 1.6 Fixer"
            VALUE "ProductVersion",   "1.6.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
