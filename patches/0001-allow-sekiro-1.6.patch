+// Walks the override directory and lists every archive file present, so the log
+// shows the full available set even before the game requests any of them.
+static LONG gInventoryCount = 0;
+
+static void LogOverrideInventory()
+{
+	wchar_t root[MAX_PATH] = { 0 };
+	GetCurrentDirectoryW(MAX_PATH, root);
+	wcscat_s(root, MAX_PATH, gModDir ? gModDir : L"\\mods");
+
+	MELog(L"[INVENTORY] Scanning override directory: %s", root);
+
+	gInventoryCount = 0;
+	WIN32_FIND_DATAW fd;
+	wchar_t pattern[MAX_PATH];
+	wcscpy_s(pattern, MAX_PATH, root);
+	wcscat_s(pattern, MAX_PATH, L"\\*");
+
+	HANDLE h = FindFirstFileW(pattern, &fd);
+	if (h == INVALID_HANDLE_VALUE)
+	{
+		MELog(L"[INVENTORY] Override directory not found or empty.");
+		return;
+	}
+
+	do
+	{
+		if (wcscmp(fd.cFileName, L".") == 0 || wcscmp(fd.cFileName, L"..") == 0)
+			continue;
+
+		wchar_t full[MAX_PATH];
+		wcscpy_s(full, MAX_PATH, root);
+		wcscat_s(full, MAX_PATH, L"\\");
+		wcscat_s(full, MAX_PATH, fd.cFileName);
+
+		if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+		{
+			MELog(L"[INVENTORY]   dir  %s\\", fd.cFileName);
+			// recurse using a stack-free depth-first walk via a helper
+			std::vector<std::wstring> subdirs;
+			subdirs.push_back(full);
+			while (!subdirs.empty())
+			{
+				std::wstring dir = subdirs.back();
+				subdirs.pop_back();
+				wchar_t p[MAX_PATH];
+				wcscpy_s(p, MAX_PATH, dir.c_str());
+				wcscat_s(p, MAX_PATH, L"\\*");
+				WIN32_FIND_DATAW sfd;
+				HANDLE sh = FindFirstFileW(p, &sfd);
+				if (sh == INVALID_HANDLE_VALUE)
+					continue;
+				do
+				{
+					if (wcscmp(sfd.cFileName, L".") == 0 || wcscmp(sfd.cFileName, L"..") == 0)
+						continue;
+					wchar_t sf[MAX_PATH];
+					wcscpy_s(sf, MAX_PATH, dir.c_str());
+					wcscat_s(sf, MAX_PATH, L"\\");
+					wcscat_s(sf, MAX_PATH, sfd.cFileName);
+					if (sfd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+					{
+						subdirs.push_back(sf);
+					}
+					else
+					{
+						long long sz = ((LONGLONG)sfd.nFileSizeHigh << 32) | (LONGLONG)sfd.nFileSizeLow;
+						const wchar_t* ext = PathFindExtensionW(sf);
+						bool isArchive = (_wcsicmp(ext, L".dcx") == 0) || (_wcsicmp(ext, L".tpf") == 0);
+						InterlockedIncrement(&gInventoryCount);
+						MELog(L"[INVENTORY]   %s %s (%lld bytes)%s", isArchive ? L"ARCH" : L"file", sf, sz,
+							isArchive ? L"" : L"   (not an archive)");
+					}
+				} while (FindNextFileW(sh, &sfd));
+				FindClose(sh);
+			}
+		}
+		else
+		{
+			long long sz = ((LONGLONG)fd.nFileSizeHigh << 32) | (LONGLONG)fd.nFileSizeLow;
+			const wchar_t* ext = PathFindExtensionW(full);
+			bool isArchive = (_wcsicmp(ext, L".dcx") == 0) || (_wcsicmp(ext, L".tpf") == 0);
+			InterlockedIncrement(&gInventoryCount);
+			MELog(L"[INVENTORY]   %s %s (%lld bytes)%s", isArchive ? L"ARCH" : L"file", full, sz,
+				isArchive ? L"" : L"   (not an archive)");
+		}
+	} while (FindNextFileW(h, &fd));
+
+	FindClose(h);
+	MELog(L"[INVENTORY] %ld file(s) available for override.", gInventoryCount);
+}
